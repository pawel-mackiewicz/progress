{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "progress",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  "env": {
    "prod": {
      "name": "progress",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "progress.mackiewicz.info",
          "custom_domain": true
        }
      ]
    }
  }
}
