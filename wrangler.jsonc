{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vue-pwa-template",
  "compatibility_date": "2026-04-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  "env": {
    "prod": {
      "name": "vue-pwa-template"
    }
  }
}
