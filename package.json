{
  "name": "vue-pwa-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --host 127.0.0.1 --port 5173 --strictPort --mode e2e",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "pnpm run build && wrangler dev",
    "prepare": "pnpm run hooks:install",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --ignore-pattern=node_modules/**",
    "lint:fix": "sh scripts/run-lint-fix.sh",
    "hooks:install": "sh scripts/install-git-hooks.sh",
    "format": "sh scripts/run-prettier.sh",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:storybook": "vitest run --project storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy": "pnpm run build && wrangler deploy --env prod"
  },
  "dependencies": {
    "@lucide/vue": "^1.33.0",
    "dexie": "^4.4.5",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/vue3-vite": "^10.5.10",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.5.10",
    "eslint-plugin-vue": "^10.10.0",
    "fake-indexeddb": "^6.2.4",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "playwright": "1.62.1",
    "prettier": "^3.9.6",
    "storybook": "^10.5.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.10",
    "vue-tsc": "^3.3.11",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.125.0"
  }
}
